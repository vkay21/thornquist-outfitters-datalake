{
  "Rules": [
    {
      "ID": "curated-fact-sales-tiering",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "curated/fact_sales/"
      },
      "Transitions": [
        {
          "Days": 90,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 365,
          "StorageClass": "GLACIER_IR"
        }
      ]
    },
    {
      "ID": "raw-archive",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "raw/"
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 180,
          "StorageClass": "GLACIER"
        }
      ]
    },
    {
      "ID": "landing-cleanup",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "landing/"
      },
      "Expiration": {
        "Days": 7
      }
    },
    {
      "ID": "quarantine-retention",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "quarantine/"
      },
      "Expiration": {
        "Days": 90
      }
    },
    {
      "ID": "athena-results-cleanup",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "athena-results/"
      },
      "Expiration": {
        "Days": 7
      }
    },
    {
      "ID": "tmp-cleanup",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "tmp/"
      },
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "abort-incomplete-mpu",
      "Status": "Enabled",
      "Filter": {},
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 2
      }
    }
  ]
}